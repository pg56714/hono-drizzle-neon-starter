@token = your-api-token


###
GET http://localhost:5173/book

###
GET http://localhost:5173/book/2

###
POST http://localhost:5173/book
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Book 1",
  "author": "1"
}

###
PUT http://localhost:5173/book/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "The Great Gatsby Updated 1",
  "author": "F. Scott Fitzgerald"
}

###
DELETE http://localhost:5173/book/3
Authorization: Bearer {{token}}